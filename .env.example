# Runtime Compose configuration. Copy to .env, replace every placeholder, then keep .env local.
# Do not use real tokens, passwords, model files, or personal paths in this example.
P2A_DB_PASSWORD=replace-with-a-local-db-password
P2A_LOCAL_TOKEN=replace-with-a-long-random-local-token
P2A_MODEL_DIR=/absolute/path/to/multilingual-e5-small

# Loopback-only published ports. Change only when the local ports conflict.
P2A_POSTGRES_HOST_PORT=5432
P2A_BACKEND_HOST_PORT=8080
P2A_DASHBOARD_HOST_PORT=4173

# Optional Compose override. The default uses Docker internal DNS and should normally stay unchanged.
# P2A_BFF_UPSTREAM_ORIGIN=http://backend:8080

# Opt-in local ONNX verification only. These are not consumed by Compose runtime.
# P2A_ONNX_MODEL_URI=file:///absolute/path/to/multilingual-e5-small/model.onnx
# P2A_ONNX_TOKENIZER_URI=file:///absolute/path/to/multilingual-e5-small/tokenizer.json

# Opt-in isolated Compose E2E only. Leave unset for the standard Lima default socket discovery.
# P2A_DOCKER_HOST=unix:///absolute/path/to/lima/docker.sock
